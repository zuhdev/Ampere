# Ampere frontend (Vite) — copy to frontend/.env and fill in.
# Addresses come from contracts/deployments/botTestnet.json after `npm run deploy:testnet -w contracts`.
VITE_REGISTRY=
VITE_VAULT=
VITE_PAYMASTER=
VITE_COUNTER=
# demo appKey created by contracts/scripts/init.ts
VITE_APP_KEY=
VITE_API_URL=http://localhost:8787
VITE_RPC_URL=https://rpc.bohr.life
