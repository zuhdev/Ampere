# Ampere frontend (Vite) — copy to frontend/.env and fill in.
# Network: testnet (968, default) or mainnet (677)
VITE_NETWORK=testnet
# Addresses come from contracts/deployments/botTestnet.json (or botMainnet.json)
# after `npm run deploy:testnet|:mainnet -w contracts`.
VITE_REGISTRY=
VITE_VAULT=
VITE_PAYMASTER=
VITE_COUNTER=
# demo appKey created by contracts/scripts/init.ts
VITE_APP_KEY=
VITE_API_URL=http://localhost:8787
VITE_RPC_URL=https://rpc.bohr.life
# mainnet: VITE_NETWORK=mainnet, VITE_RPC_URL=https://rpc.botchain.ai
